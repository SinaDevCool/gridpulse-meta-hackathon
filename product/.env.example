VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-side-secret-key
VITE_ANALYTICS_API_URL=https://analytics.example.com
GRIDPULSE_PRODUCT_MODE=finder
NEO4J_URI=neo4j://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_ENCRYPTED=false
# Private, authenticated Neo4j decision inspector. Set false for emergency rollback.
VITE_PRIVATE_GRAPH_UI=true
VITE_INTEGRATED_ACTIVATION_STUDY=true
# Enable only after the private analytics service and governed workspaces are configured.
VITE_GRAPH_STUDY_SUBMISSION=false

# Server-only copilot settings. Put actual keys in ignored .dev.vars, never VITE_ variables.
COPILOT_PROVIDER=openai
COPILOT_MODEL=gpt-4o-mini
# For Meta: COPILOT_PROVIDER=meta and COPILOT_MODEL=muse-spark-1.3
# META_API_KEY= (server secret)
# OPENAI_API_KEY= (server secret)
# Optional explicit fallback; never enabled implicitly.
# COPILOT_FALLBACK_PROVIDER=openai
# COPILOT_FALLBACK_MODEL=gpt-4o-mini

# Private-runtime German planning pilot; public synthetic submissions stay disabled.
VITE_GERMAN_PLANNING_ENABLED=false
