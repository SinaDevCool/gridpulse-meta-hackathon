{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "dev": "vite dev",
    "prepare:maplibre-worker": "node scripts/prepare-maplibre-worker.mjs",
    "build": "npm run prepare:maplibre-worker && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "verify:local": "node scripts/resource-safe-validation.mjs",
    "verify:local:full": "node scripts/resource-safe-validation.mjs full",
    "verify:memory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-validation-memory.ps1",
    "test:validation-tools": "node --test scripts/resource-safe-validation.test.mjs scripts/solution-boundaries.test.mjs scripts/e2e-manifest.test.mjs scripts/run-e2e.test.mjs scripts/candidate-artifact.test.mjs scripts/validation-workflow.test.mjs",
    "test:browser": "node scripts/run-e2e.mjs",
    "test:operations:database": "node scripts/test-operations-database.mjs",
    "test:operations:runtime": "playwright test --config playwright.runtime.config.ts",
    "test:product:navigation": "vitest run src/components/product/product-navigation.test.ts src/config/product-mode.test.ts",
    "test:product:theme": "vitest run src/features/theme/theme-contract.test.ts",
    "test:product:operations": "vitest run src/features/operations src/features/grid-connection/operations-readiness.test.ts",
    "verify:product:fast": "npm run typecheck && npm run test:product:navigation && npm run test:product:theme && npm run test:product:operations",
    "test:e2e": "playwright test",
    "test:e2e:finder": "playwright test --config playwright.finder.config.ts",
    "grid:test": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m unittest discover -s services/grid-data/tests\"",
    "grid:fetch:brandenburg": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli fetch-osm --bbox 52.22,13.15,52.40,13.55 --endpoint https://overpass.kumi.systems/api/interpreter --output public/power-finder/brandenburg-osm.json\"",
    "grid:build:rzreg-performance": "python scripts/build-rzreg-performance.py",
    "grid:write-sql": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli write-sql --input public/power-finder/brandenburg-osm.json --output services/grid-data/releases/brandenburg-osm-load.sql\"",
    "grid:audit:release": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli audit-release --input public/power-finder/brandenburg-osm.json --output output/brandenburg-osm-audit.json\"",
    "grid:warm:tiles": "python scripts/warm_power_finder_tiles.py",
    "grid:validate:c1": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-c1-benchmark --output public/power-finder/c1-benchmark-validation.json\"",
    "grid:benchmark:a": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-benchmark-a --output output/benchmark-a.json\"",
    "grid:benchmark:b": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-benchmark-b --output output/benchmark-b.json\"",
    "grid:benchmark:c": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-benchmark-c --output output/benchmark-c.json\"",
    "grid:benchmark:d": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-benchmark-d --output output/benchmark-d.json\"",
    "grid:benchmark:e": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-benchmark-e --output output/benchmark-e.json\"",
    "grid:validate:reference-capacity": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-reference-capacity-map --output public/power-finder/reference-capacity-map.json\"",
    "grid:build:50hertz-synthetic-capacity": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli build-50hertz-synthetic-capacity --output output/50hertz-synthetic-opportunity.json\"",
    "grid:build:50hertz-regional": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli build-50hertz-regional-screening --source work/50hertz-overpass.json --output output/50hertz-regional-screening.json --limit 20\"",
    "grid:build:50hertz-preapplication": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli build-50hertz-preapplication --regional output/50hertz-regional-screening.json --output output/50hertz-top-five-preapplication.json --request output/50hertz-grid-connection-request.md --requested-mw 500 --target-year 2030\"",
    "grid:build:berlin-capacity": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli build-berlin-synthetic-capacity --output public/power-finder/berlin-synthetic-capacity.json\"",
    "grid:publish:c1": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli publish-c1-benchmark --input public/power-finder/c1-benchmark-validation.json\"",
    "grid:validate:c2": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-c2-benchmark --output public/power-finder/c2-hourly-benchmark.json\"",
    "grid:validate:p0": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-pilot-package --kind synthetic --input services/grid-data/fixtures/synthetic-pilot\"",
    "grid:validate:r1": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-release1 --input services/grid-data/fixtures/synthetic-pilot\"",
    "grid:validate:r2": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-release2 --input services/grid-data/fixtures/synthetic-pilot --output output/release2-private-benchmark.json --model-artifact output/models/release2-surrogate.joblib --public-output public/power-finder/release2-governance.json\"",
    "grid:validate:r3": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-release3 --input services/grid-data/fixtures/synthetic-pilot --output output/release3-private-shadow.json --public-output public/power-finder/release3-governance.json\"",
    "grid:validate:synthetic-pilot": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli validate-synthetic-pilot --input services/grid-data/fixtures/synthetic-pilot --output output/synthetic-pilot-acceptance.json --public-output public/power-finder/release4-governance.json\"",
    "grid:validate:r5": "tsx scripts/build-release5-governance.ts public/power-finder/release5-governance.json",
    "grid:neo4j:up": "docker compose -f compose.neo4j.yml up -d",
    "grid:neo4j:down": "docker compose -f compose.neo4j.yml down",
    "grid:validate:neo4j": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python services/grid-data/scripts/validate_neo4j.py\"",
    "grid:publish:c2": "powershell -NoProfile -Command \"$env:PYTHONPATH=(Resolve-Path 'services/grid-data/src').Path; python -m grid_data.cli publish-c2-benchmark --input public/power-finder/c2-hourly-benchmark.json\"",
    "verify:power-finder": "npm run grid:test && npm run typecheck && npm run test && npm run build && npm run test:e2e:finder",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "health:production": "node scripts/check-production-health.mjs",
    "health:production:map": "node scripts/check-production-map.mjs",
    "check:performance-budgets": "node scripts/check-performance-budgets.mjs",
    "security:public-finder": "node scripts/check-public-finder-security.mjs",
    "verify:phase0": "npm run check:encoding && npm run typecheck && npm run lint:app && npm run test && npm run grid:test && npm run build && npm run test:e2e:finder && npm run audit:production",
    "verify:canonical": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-canonical-analytics.ps1",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint:app": "eslint src vite.config.ts vitest.config.ts playwright.config.ts playwright.finder.config.ts playwright.runtime.config.ts",
    "lint:product": "npm run lint:app",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "@svg-maps/germany": "^2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/router-plugin": "^1.167.28",
    "@tanstack/zod-adapter": "^1.167.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^6.11.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-is": "^19.2.0",
    "read-excel-file": "^5.8.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.1",
    "write-excel-file": "^2.3.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "supabase": "^2.109.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "dompurify": ">=3.4.13",
    "js-yaml": ">=4.3.1",
    "nanoid": ">=3.3.17",
    "postcss": ">=8.5.23"
  }
}
