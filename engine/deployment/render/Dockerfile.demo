FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PORT=10000
WORKDIR /app
COPY .render-core/services/grid-data /core
COPY pyproject.toml ./
COPY src ./src
COPY deployment/render/demo.py ./deployment/render/demo.py
RUN pip install --no-cache-dir "/core[api]" . "numpy>=1.26,<2" "scipy>=1.11,<2" "scikit-learn>=1.5,<2" && useradd --create-home --uid 10001 demo
USER demo
CMD ["sh", "-c", "exec uvicorn deployment.render.demo:app --host 0.0.0.0 --port ${PORT} --workers 1"]
